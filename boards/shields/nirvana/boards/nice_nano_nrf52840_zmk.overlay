// 将 SPI 总线引脚重映射到 pro_micro 4/5/6
// nice!nano v2 外部 SPI 通常为 spi1；若编译报错请改为 spi0_default/spi0_sleep
&spi1_default {
    /delete-node/ group1;
    group1 {
        psels = <NRF_PSEL(SPIM_SCK,  0, 20)>,  // pro_micro 4 = P0.20 = SCLK
                <NRF_PSEL(SPIM_MISO, 0, 22)>,  // pro_micro 5 = P0.22 = MISO
                <NRF_PSEL(SPIM_MOSI, 0, 24)>;  // pro_micro 6 = P0.24 = MOSI
    };
};

&spi1_sleep {
    /delete-node/ group1;
    group1 {
        psels = <NRF_PSEL(SPIM_SCK,  0, 20)>,
                <NRF_PSEL(SPIM_MISO, 0, 22)>,
                <NRF_PSEL(SPIM_MOSI, 0, 24)>;
        low-power-enable;
    };
};
