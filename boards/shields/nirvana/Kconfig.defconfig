if SHIELD_NIRVANA_RIGHT

# Name must be less than 16 characters long!
config ZMK_KEYBOARD_NAME
    default "Nirvana"

config ZMK_SPLIT_ROLE_CENTRAL
    default y


# Other settings

config ZMK_POINTING
    default y
# Assuming pointing device uses SPI
config SPI
    default y

config ZMK_BLE_EXPERIMENTAL_CONN
    default y

endif


if SHIELD_NIRVANA_LEFT || SHIELD_NIRVANA_RIGHT

config ZMK_SPLIT
    default y

endif
